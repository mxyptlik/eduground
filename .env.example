# Runtime
NODE_ENV=development
CURRICULUM_TUTOR_APP_ENV=development
CURRICULUM_TUTOR_APP_NAME=Curriculum Tutor API
CURRICULUM_TUTOR_API_PREFIX=/api
CURRICULUM_TUTOR_SECRET_KEY=change-me-in-non-dev
CURRICULUM_TUTOR_WEB_BASE_URL=http://localhost:5173
CURRICULUM_TUTOR_API_PUBLIC_BASE_URL=http://localhost:8000
CURRICULUM_TUTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CURRICULUM_TUTOR_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CURRICULUM_TUTOR_SESSION_COOKIE_NAME=curriculum_tutor_session
CURRICULUM_TUTOR_SESSION_COOKIE_SECURE=false
CURRICULUM_TUTOR_SESSION_COOKIE_DOMAIN=
CURRICULUM_TUTOR_AUTO_CREATE_SCHEMA=true
CURRICULUM_TUTOR_MAX_API_REQUEST_BYTES=1000000
CURRICULUM_TUTOR_AUTH_RATE_LIMIT_REQUESTS=10
CURRICULUM_TUTOR_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CURRICULUM_TUTOR_LOG_LEVEL=INFO
CURRICULUM_TUTOR_LOG_JSON=true
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CURRICULUM_TUTOR_WORKER_PROCESSES=2
CURRICULUM_TUTOR_WORKER_THREADS=4

# Clerk auth and org sync
CURRICULUM_TUTOR_CLERK_ENABLED=true
CURRICULUM_TUTOR_CLERK_API_URL=https://api.clerk.com/v1
CURRICULUM_TUTOR_CLERK_SECRET_KEY=sk_test_REPLACE_ME
CURRICULUM_TUTOR_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CURRICULUM_TUTOR_CLERK_JWKS_URL=https://YOUR-CLERK-FRONTEND-API/.well-known/jwks.json
CURRICULUM_TUTOR_CLERK_JWT_ISSUER=https://YOUR-CLERK-FRONTEND-API
CURRICULUM_TUTOR_CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CURRICULUM_TUTOR_CLERK_WEBHOOK_SIGNING_SECRET=
CURRICULUM_TUTOR_CLERK_ACTIVE_ORGANIZATION_HEADER=X-Active-Organization-Id
CURRICULUM_TUTOR_CLERK_SESSION_COOKIE_NAME=__session
CURRICULUM_TUTOR_CLERK_SYNC_READ_REPAIR=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eduground
POSTGRES_USER=eduground
POSTGRES_PASSWORD=eduground
CURRICULUM_TUTOR_DATABASE_URL=postgresql+psycopg://eduground:eduground@localhost:5432/eduground

# Redis
CURRICULUM_TUTOR_REDIS_URL=redis://localhost:6379/0

# Qdrant
CURRICULUM_TUTOR_QDRANT_URL=http://localhost:6333
CURRICULUM_TUTOR_QDRANT_API_KEY=
CURRICULUM_TUTOR_QDRANT_COLLECTION_NAME=eduground_chunks

# Cloudflare R2 object storage
CURRICULUM_TUTOR_S3_ENDPOINT=https://dummy-account-id.r2.cloudflarestorage.com
CURRICULUM_TUTOR_S3_ACCESS_KEY=dummy-r2-access-key
CURRICULUM_TUTOR_S3_SECRET_KEY=dummy-r2-secret-key
CURRICULUM_TUTOR_S3_BUCKET=eduground
CURRICULUM_TUTOR_S3_USE_SSL=true
CURRICULUM_TUTOR_S3_REGION=auto
CURRICULUM_TUTOR_S3_CONNECT_TIMEOUT_SECONDS=2
CURRICULUM_TUTOR_S3_READ_TIMEOUT_SECONDS=2
CURRICULUM_TUTOR_OBJECT_STORAGE_BACKEND=auto
CURRICULUM_TUTOR_OBJECT_STORAGE_LOCAL_FALLBACK_ENABLED=true
CURRICULUM_TUTOR_OBJECT_STORAGE_LOCAL_DIR=.eduground_local_storage
CURRICULUM_TUTOR_OBJECT_STORAGE_PRIMARY_HEALTH_TTL_SECONDS=60
CURRICULUM_TUTOR_OBJECT_STORAGE_PRIMARY_FAILURE_BACKOFF_SECONDS=300

# Provider routing
CURRICULUM_TUTOR_OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
CURRICULUM_TUTOR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CURRICULUM_TUTOR_OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
CURRICULUM_TUTOR_OPENROUTER_RERANK_MODEL=openai/gpt-4.1-mini
CURRICULUM_TUTOR_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
CURRICULUM_TUTOR_OPENROUTER_HTTP_REFERER=http://localhost:5173
CURRICULUM_TUTOR_OPENROUTER_TITLE=Eduground Local
CURRICULUM_TUTOR_GEMINI_FALLBACK_ENABLED=true
CURRICULUM_TUTOR_GEMINI_API_KEY=REPLACE_ME
CURRICULUM_TUTOR_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CURRICULUM_TUTOR_GEMINI_CHAT_MODEL=gemini-2.0-flash
CURRICULUM_TUTOR_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CURRICULUM_TUTOR_GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=3072
CURRICULUM_TUTOR_RERANKER_ENABLED=true
CURRICULUM_TUTOR_RERANKER_TOP_N=12
CURRICULUM_TUTOR_UNSTRUCTURED_API_KEY=unstructured_REPLACE_ME
CURRICULUM_TUTOR_UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
CURRICULUM_TUTOR_UNSTRUCTURED_OCR_STRATEGY=ocr_only
# Page-text OCR fallback after Unstructured failure; this is separate from image cards.
# Uses the same CURRICULUM_TUTOR_OPENROUTER_API_KEY and evaluation spend ledger.
CURRICULUM_TUTOR_OCR_VISION_ENABLED=false
CURRICULUM_TUTOR_OCR_VISION_MODEL=deepseek/deepseek-v4.1-flash
CURRICULUM_TUTOR_OCR_VISION_MAX_PAGES=100
CURRICULUM_TUTOR_OCR_VISION_MAX_OUTPUT_TOKENS=4096

# Evaluation programme roles (independent of product chat defaults)
EDUGROUND_EVAL_ANSWER_MODEL=gemini-3.5-flash
EDUGROUND_EVAL_AUTHOR_MODEL=moonshotai/kimi-k2.6
EDUGROUND_EVAL_JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# Set both provider and model to the actual ingestion/query embedding identity.
# EDUGROUND_EVAL_EMBEDDING_PROVIDER=gemini
# EDUGROUND_EVAL_EMBEDDING_MODEL=gemini-embedding-001
# Set an independently pinned model for RAGAS answer relevancy.
# EDUGROUND_EVAL_RELEVANCE_EMBEDDING_PROVIDER=gemini
# EDUGROUND_EVAL_RELEVANCE_EMBEDDING_MODEL=gemini-embedding-001
# EDUGROUND_EVAL_RERANKER_MODEL=<pin a verified OpenRouter model>
EDUGROUND_EVAL_CANDIDATE_K=20
EDUGROUND_EVAL_FINAL_K=5
EDUGROUND_EVAL_MAX_CONTEXT_TOKENS=8000
EDUGROUND_EVAL_MAX_API_SPEND_USD=10
# Bearer token is used only by the optional API-based course uploader.
EDUGROUND_EVAL_BEARER_TOKEN=
# Controlled ingestion ledger: set these three in the environment of the
# dedicated evaluation worker process only. They are read from the process
# environment (never from this file) so ordinary product workers are unaffected.
# EDUGROUND_EVAL_BUDGET_LEDGER=<shared pilot directory>/budget.sqlite3
# EDUGROUND_EVAL_PRICE_REGISTRY=<dated sourced price registry>.json
# (EDUGROUND_EVAL_MAX_API_SPEND_USD above completes the trio)
# Visual evidence layer (text cards; off by default). Any paid vision call needs
# the same ledger; provider may be openrouter (preferred) or gemini.
# CURRICULUM_TUTOR_VISUAL_ENABLED=false
# CURRICULUM_TUTOR_VISUAL_PROVIDER=openrouter
# CURRICULUM_TUTOR_VISUAL_MODEL=<pin after capability probe>
# CURRICULUM_TUTOR_VISUAL_CACHE_DIR=.eduground_visual_cache

# Upload/runtime limits
CURRICULUM_TUTOR_MAX_UPLOAD_BYTES=52428800
CURRICULUM_TUTOR_SIGNED_URL_TTL_SECONDS=900

# Serving capacity controls; tune with measured read/chat runs
CURRICULUM_TUTOR_GENERATION_ADMISSION_ENABLED=true
CURRICULUM_TUTOR_GENERATION_MAX_CONCURRENT=8
CURRICULUM_TUTOR_GENERATION_MAX_PER_USER=2
CURRICULUM_TUTOR_GENERATION_MAX_PER_ORG=8
CURRICULUM_TUTOR_GENERATION_ADMISSION_WAIT_SECONDS=0
CURRICULUM_TUTOR_GENERATION_LEASE_SECONDS=120
CURRICULUM_TUTOR_PROVIDER_MAX_CONNECTIONS=32
CURRICULUM_TUTOR_PROVIDER_POOL_TIMEOUT_SECONDS=5
CURRICULUM_TUTOR_REDIS_SOCKET_TIMEOUT_SECONDS=2
CURRICULUM_TUTOR_CHAT_HISTORY_MAX_MESSAGES=40
CURRICULUM_TUTOR_CHAT_HISTORY_MAX_CHARS=24000
CURRICULUM_TUTOR_ANSWER_CONTEXT_MAX_CHARS=32000

# Observability and local dashboard access
CURRICULUM_TUTOR_OTEL_ENABLED=false
CURRICULUM_TUTOR_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
CURRICULUM_TUTOR_OTEL_EXPORTER_OTLP_HEADERS=
CURRICULUM_TUTOR_OTEL_EXPORTER_TIMEOUT_SECONDS=10
CURRICULUM_TUTOR_OTEL_TRACE_SAMPLE_RATIO=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# Legacy aliases supported by the app config for local compatibility
DATABASE_URL=postgresql+psycopg://eduground:eduground@localhost:5432/eduground
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MINIO_ENDPOINT=https://dummy-account-id.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=dummy-r2-access-key
MINIO_SECRET_KEY=dummy-r2-secret-key
MINIO_BUCKET=eduground
MINIO_USE_SSL=true
APP_ENV=development
APP_NAME=Curriculum Tutor API
APP_BASE_URL=http://localhost:5173

# Browser and load-test scaffolding
PLAYWRIGHT_BASE_URL=http://localhost:5173
PLAYWRIGHT_CLERK_EMAIL=
PLAYWRIGHT_CLERK_PASSWORD=
K6_API_BASE_URL=http://localhost:8000
K6_BEARER_TOKEN=
K6_ACTIVE_ORG_ID=
K6_NOTEBOOK_ID=
PRODUCT_VUS=5
PRODUCT_DURATION=30s
K6_CHAT_MESSAGE=Summarize the uploaded source with citations.
