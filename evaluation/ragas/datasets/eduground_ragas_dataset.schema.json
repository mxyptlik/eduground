{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EduGround RAGAS evaluation dataset",
  "type": "object",
  "required": ["dataset_id", "version", "samples", "source_manifest"],
  "properties": {
    "dataset_id": {"type": "string"},
    "version": {"type": "string"},
    "created_at_utc": {"type": "string"},
    "source_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_label", "sha256", "notebook_id", "source_id"],
        "properties": {
          "source_label": {"type": "string"},
          "sha256": {"type": "string"},
          "notebook_id": {"type": "string"},
          "source_id": {"type": "string"},
          "page_or_slide_range": {"type": "string"}
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["sample_id", "question", "reference_answer", "reference_contexts", "source_ids", "source_chunk_id", "review_status"],
        "properties": {
          "sample_id": {"type": "string"},
          "question": {"type": "string", "minLength": 8},
          "reference_answer": {"type": "string", "minLength": 1},
          "reference_contexts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "source_chunk_id": {"type": "string", "minLength": 1},
          "expected_locator": {"type": "string"},
          "question_type": {"type": "string"},
          "difficulty": {"type": "string"},
          "authoring_method": {"type": "string"},
          "review_status": {"enum": ["draft", "approved", "rejected"]},
          "reviewer": {"type": "string"},
          "reviewed_at_utc": {"type": "string"}
        }
      }
    }
  }
}
