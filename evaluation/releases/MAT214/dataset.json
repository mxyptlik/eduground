    {
      "sample_id": "MAT214-e27df1895cd8c7c3",
      "question": "What are the three types of elementary row operations defined for matrices, and how do they form the basis for defining row equivalence between two matrices?",
      "reference_answer": "The three elementary row operations are: (1) interchanging rows i and j, (2) multiplying row i by a nonzero scalar s, and (3) adding s times row i to row j. A matrix A is said to be row equivalent to a matrix B if B can be obtained from A by performing a finite sequence of these elementary row operations.",
      "evidence": [
        {
          "source_id": "7038be63-cf21-4c1b-90a0-700cad89979b",
          "chunk_id": "88257400-baa3-4005-a86e-d83bea2a1f7d",
          "quote": "1.Interchangerows i and j R <-->R i j 2.Multiplyrow i by s,where s ≠0 sR -->R i i 3.Add s timesrow i torow j sR +R -->R i j j",
          "locator": "page 8",
          "evidence_group": null
        },
        {
          "source_id": "bfaa1ed3-cbe6-4765-9293-7933c0848f50",
          "chunk_id": "948a36b5-add6-41cf-aae9-62c5e5b84b92",
          "quote": "matrix A is said to be row equivalent to matrix , written as A B if B can be obtained from A by performing a finite sequence of elementary row operations on A.",
          "locator": "page 11",
          "evidence_group": null
        }
      ],
      "answerable": true,
