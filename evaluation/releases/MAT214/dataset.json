    {
      "sample_id": "MAT214-62429b20e0b80014",
      "question": "What condition characterizes the linear dependence of a set containing exactly two vectors, and how does this relate to the concept of one vector being a scalar multiple of the other?",
      "reference_answer": "A set containing exactly two vectors is linearly dependent if at least one of the vectors is a multiple of the other. The same set is linearly independent if and only if neither of the vectors is a multiple of the other.",
      "evidence": [
        {
          "source_id": "1ac777f2-7263-43bc-b615-f99135aadf94",
          "chunk_id": "4b1f3d6c-9262-4b02-b06b-c21de71e5334",
          "quote": " A set of two vectors {v , v } is linearly dependent if 1 2 at least one of the vectors is a multiple of the other.  The set is linearly independent if and only if neither of the vectors is a multiple of the other.",
          "locator": "page 8",
          "evidence_group": null
        }
      ],
      "answerable": true,
